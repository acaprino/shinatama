{
  "name": "shinatama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts",
    "desktop": "cargo build --locked -p shinatama-terminal --bin shinatama-terminal-helper -p shinatama-engine --bin shinatama-session-helper --bin shinatama-hook --features shinatama-engine/session-reader -j1 && cd apps/desktop && tauri dev",
    "desktop:build": "cargo build --locked --release -p shinatama-terminal --bin shinatama-terminal-helper -p shinatama-engine --bin shinatama-session-helper --bin shinatama-hook --features shinatama-engine/session-reader -j1 && cd apps/desktop && tauri build --no-bundle --features custom-protocol",
    "build:tl1": "tsc --noEmit --project apps/desktop/tests/tl1/tsconfig.json && vite build --config apps/desktop/tests/tl1/vite.config.ts",
    "desktop:tl1": "cargo build --locked -p shinatama-terminal --bin shinatama-terminal-helper -p shinatama-engine --bin shinatama-session-helper --bin shinatama-hook --features shinatama-engine/session-reader -j1 && cd apps/desktop && tauri build --debug --no-bundle --features tl1-proof,custom-protocol --config tests/tl1/tauri.tl1.conf.json",
    "test:tl1": "node apps/desktop/tests/tl1/proof.mjs",
    "test": "node --experimental-strip-types --test apps/desktop/tests/*.test.ts",
    "test:desktop": "node apps/desktop/tests/desktop-smoke.mjs",
    "test:projects": "node apps/desktop/tests/projects-smoke.mjs",
    "test:storage": "node apps/desktop/tests/storage-smoke.mjs",
    "test:state": "node apps/desktop/tests/state-smoke.mjs",
    "test:catalog": "node apps/desktop/tests/catalog-smoke.mjs",
    "test:native-picker": "node apps/desktop/tests/native-picker-smoke.mjs",
    "test:new-project": "node apps/desktop/tests/new-project-smoke.mjs",
    "test:ui": "node apps/desktop/tests/ui-flow-smoke.mjs",
    "test:native": "node apps/desktop/tests/native-frame-smoke.mjs",
    "test:browser": "node apps/desktop/tests/browser-smoke.mjs",
    "test:drag": "node apps/desktop/tests/pane-drag-smoke.mjs",
    "test:maintenance": "node apps/desktop/tests/maintenance-smoke.mjs",
    "plan:check": "python scripts/implementation.py validate",
    "plan:status": "python scripts/implementation.py status",
    "verify": "pwsh -NoProfile -File scripts/verify.ps1"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
