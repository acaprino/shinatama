{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shinatama Prototype",
  "version": "0.1.0",
  "identifier": "dev.shinatama.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Shinatama — terminal workspace", "width": 1440, "height": 920, "minWidth": 760, "minHeight": 500, "decorations": false, "backgroundColor": "#09111d" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": false }
}
