{
  "name": "billion-context",
  "version": "0.1.207",
  "description": "Musashi Terminal source-owned private context-compression sidecar",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/agent/opencode-native.js"
  },
  "bin": {
    "bili": "./dist/index.js",
    "bili-proxy": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "keywords": [
    "context",
    "compression",
    "proxy",
    "acp",
    "ai",
    "agent",
    "claude-code",
    "cursor",
    "codex",
    "aider",
    "anthropic",
    "openai",
    "pi-package"
  ],
  "license": "MIT",
  "author": "ranxianglei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranxianglei/billion-context.git"
  },
  "homepage": "https://github.com/ranxianglei/billion-context#readme",
  "bugs": {
    "url": "https://github.com/ranxianglei/billion-context/issues"
  },
  "dependencies": {
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/semver": "^7.7.1",
    "@types/ws": "8.18.2",
    "acp-kernel": "file:./kernel",
    "billion-context-pi-subagents": "file:./pi-subagents",
    "esbuild": "^0.27.0",
    "fzstd": "0.1.1",
    "jsonc-parser": "^3.3.1",
    "node-forge": "^1.4.0",
    "semver": "7.8.5",
    "tar": "^7.5.22",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typebox": "^1.3.34",
    "typescript": "^5.5.0",
    "undici": "^7.29.0",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "LICENSE",
    "PROVENANCE.md",
    "provenance.json",
    "dist"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/ranxianglei/billion-context/master/docs/logo.png",
    "extensions": [
      "./dist/agent/pi-native.js"
    ]
  },
  "private": true
}
